rules_version = '2';

// Firestore-Regeln für das Soul-Link-Dashboard.
// Einfügen in der Firebase-Konsole: Firestore > Regeln > alles ersetzen > Veröffentlichen.
//
// Jeder mit dem Link darf lesen und schreiben (keine Anmeldung). Die Regeln lassen aber nur
// Daten in der Form des Dashboards zu: bekannte Felder, begrenzte Textlängen, keine fremden
// Sammlungen. Run-Daten (meta) und Run-Verlauf (history) können nicht gelöscht werden.
// Datenmodell: docs/ARCHITEKTUR.md. Neue Felder dort UND hier ergänzen, sonst schlägt Speichern fehl.

service cloud.firestore {
  match /databases/{database}/documents {

    function str(v, max) { return v is string && v.size() <= max; }
    function players(m) { return m is map && m.keys().hasOnly(['p0', 'p1', 'p2']); }
    function smallMap(m, max) { return m is map && m.size() <= max; }

    // ---------- meta/main: Spieler, aktueller Run, Zähler, Level-Caps ----------
    function validRun(r) {
      return r is map
        && r.keys().hasOnly(['no', 'status', 'enders', 'where', 'cause'])
        && r.get('no', 1) is int
        && r.get('status', 'run') in ['run', 'lost', 'won']
        && players(r.get('enders', {}))
        && str(r.get('where', ''), 200)
        && str(r.get('cause', ''), 300);
    }
    function validPlayers(p) {
      return players(p)
        && str(p.get('p0', {}).get('name', ''), 40)
        && str(p.get('p1', {}).get('name', ''), 40)
        && str(p.get('p2', {}).get('name', ''), 40);
    }
    function validCaps(c) {
      return c is map
        && c.keys().hasOnly(['beaten', 'lv'])
        && smallMap(c.get('beaten', {}), 20)
        && smallMap(c.get('lv', {}), 20);
    }
    function validMeta(d) {
      return d.keys().hasOnly(['players', 'run', 'tally', 'caps', 'backupAt'])
        && validPlayers(d.get('players', {}))
        && validRun(d.get('run', {}))
        && players(d.get('tally', {}))
        && validCaps(d.get('caps', {}))
        && str(d.get('backupAt', ''), 40);
    }

    match /meta/{doc} {
      allow read: if true;
      allow create, update: if doc == 'main' && validMeta(request.resource.data);
      allow delete: if false;
    }

    // ---------- routes/<id>: eine Route ----------
    function validCell(c) {
      return c is map
        && c.keys().hasOnly(['sp', 'nick', 'st'])
        && str(c.get('sp', ''), 30)
        && str(c.get('nick', ''), 40)
        && c.get('st', '') in ['', 'alive', 'dead', 'miss'];
    }
    function validCells(c) {
      return players(c)
        && validCell(c.get('p0', {}))
        && validCell(c.get('p1', {}))
        && validCell(c.get('p2', {}));
    }
    function validRoute(d) {
      return d.keys().hasOnly(['order', 'name', 'nick', 'extra', 'hint', 'custom', 'cells', 'killer', 'deaths', 'cause'])
        && d.get('order', 0) is number
        && str(d.get('name', ''), 80)
        && str(d.get('nick', ''), 40)
        && str(d.get('cause', ''), 300)
        && str(d.get('hint', ''), 300)
        && d.get('extra', false) is bool
        && d.get('custom', false) is bool
        && d.get('killer', -1) is int
        && d.get('killer', -1) >= -1
        && d.get('killer', -1) <= 2
        && players(d.get('deaths', {}))
        && validCells(d.get('cells', {}));
    }

    match /routes/{id} {
      allow read: if true;
      // r01 … r43 sind Standardrouten, c… sind selbst angelegte Routen.
      allow create, update: if id.matches('r[0-9]{2}|c[a-z0-9]{1,12}') && validRoute(request.resource.data);
      allow delete: if true;
    }

    // ---------- history/<id>: ein abgeschlossener Run ----------
    function validHistory(d) {
      return d.keys().hasOnly(['no', 'status', 'enders', 'where', 'cause', 'endedAt', 'badges', 'lastCap', 'links', 'deadLinks', 'perPlayer'])
        && str(d.get('where', ''), 200)
        && str(d.get('cause', ''), 300)
        && str(d.get('endedAt', ''), 40)
        && str(d.get('lastCap', ''), 60)
        && d.get('deadLinks', []) is list
        && d.get('deadLinks', []).size() <= 200
        && players(d.get('perPlayer', {}));
    }

    match /history/{id} {
      allow read: if true;
      allow create: if id.matches('run[0-9]+-[a-z0-9]+') && validHistory(request.resource.data);
      // Abgeschlossene Runs ändern sich nicht. Gleiche Daten erneut schreiben (Backup einspielen) ist erlaubt.
      allow update: if request.resource.data == resource.data;
      allow delete: if false;
    }
  }
}
